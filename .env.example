# Example environment configuration

# Application environment (development, production, test)
NODE_ENV=production

# Ports
PORT=3000
GRPC_PORT=50051

# Public url
APP_BASE_URL=http://localhost:3000

# Logging level (error, warn, info, debug)
LOG_LEVEL=info

# Database configuration
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# Connection pool settings
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# Rate limit window (ms)
RATE_LIMIT_WINDOW_MS=300000

# Max requests per window
RATE_LIMIT_MAX_REQUESTS=100

# Request body size limit)
BODY_LIMIT=10kb

# Background scanning configuration
# Scan interval (ms)
SCAN_INTERVAL_MS=300000

# GitHub API configuration
# GitHub token (optional)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# GitHub request timeout (ms)
GITHUB_API_TIMEOUT_MS=10000

# Redis
# Redis url
REDIS_URL=redis://localhost:6379

# Cache TTL in seconds (600 = 10 minutes)
REDIS_TTL_SECONDS=600

# Enable/disable caching
CACHE_ENABLED=true

# SMTP Email Configuration
# SMTP Server Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=true

# Email sender address
SMTP_EMAIL_FROM=notifications@your-domain.com

# SMTP Authentication (may be optional depending on provider)
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Email Delivery Settings
EMAIL_TIMEOUT_MS=30000
EMAIL_RETRY_ATTEMPTS=3
EMAIL_RETRY_MAX_DELAY_MS=10000
EMAIL_RETRY_BASE_DELAY_MS=1000

# Monitoring & Health Checks
# Health check interval (milliseconds)
HEALTH_CHECK_INTERVAL_MS=30000

# Enable Prometheus metrics endpoint
METRICS_ENABLED=true

# Elasticsearch REST API
ELASTICSEARCH_HOSTS=http://elasticsearch:9200

# Kibana web UI
KIBANA_HOST=http://localhost:5601

# Message Broker (RabbitMQ) Configuration
RABBITMQ_USER=RABBITMQ_USER
RABBITMQ_PASSWORD=RABBITMQ_PASSWORD
RABBITMQ_URL=amqp://RABBITMQ_USER:RABBITMQ_PASSWORD@localhost:5672
RABBITMQ_PUBLISH_CONFIRM_TIMEOUT_MS=5000

# Outbox worker configuration
OUTBOX_WORKER_PORT=3100
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_ATTEMPTS=5
