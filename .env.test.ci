NODE_ENV=test

PORT=3000
GRPC_PORT=50052
APP_BASE_URL=http://localhost:3000
LOG_LEVEL=error

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/releases
DB_MAX_CONNECTIONS=5
DB_IDLE_TIMEOUT_MS=10000
DB_CONNECTION_TIMEOUT_MS=3000

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=50
BODY_LIMIT=10kb

SCAN_INTERVAL_MS=999999999

GITHUB_API_TIMEOUT_MS=5000

REDIS_URL=redis://localhost:6379
REDIS_TTL_SECONDS=60
CACHE_ENABLED=false

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_EMAIL_FROM=test@example.com
SMTP_USER=
SMTP_PASS=
EMAIL_TIMEOUT_MS=5000
EMAIL_RETRY_ATTEMPTS=1

HEALTH_CHECK_INTERVAL_MS=60000
METRICS_ENABLED=false