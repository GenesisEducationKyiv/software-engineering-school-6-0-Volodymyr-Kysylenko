{
    "name": "github-release-notifier",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "dotenv -e .env.development -- tsx watch src/server.ts",
        "dev:prod": "dotenv -e .env.production -- tsx watch src/server.ts",
        "build": "tsc -p tsconfig.json",
        "start": "dotenv -e .env.production -- node dist/server.js",
        "start:dev": "dotenv -e .env.development -- node dist/server.js",
        "lint": "eslint src --ext .ts",
        "lint:fix": "eslint src --ext .ts --fix",
        "test": "dotenv -e .env.test -- cross-env NODE_ENV=test vitest run",
        "test:watch": "dotenv -e .env.test -- cross-env NODE_ENV=test vitest",
        "migrate": "dotenv -e .env.development -- tsx src/db/migrate.ts",
        "migrate:prod": "dotenv -e .env.production -- tsx src/db/migrate.ts"
    },
    "dependencies": {
        "@grpc/grpc-js": "^1.12.2",
        "@grpc/proto-loader": "^0.8.0",
        "dotenv": "^16.4.5",
        "express": "^4.21.2",
        "redis": "^4.7.0",
        "express-rate-limit": "^8.3.2",
        "helmet": "^8.1.0",
        "nodemailer": "^6.10.0",
        "pg": "^8.13.1",
        "prom-client": "^15.1.3",
        "zod": "^3.24.1",
        "swagger-ui-express": "^5.0.1",
        "yaml": "^2.8.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.15.0",
        "@types/express": "^5.0.0",
        "@types/node": "^22.10.2",
        "@types/nodemailer": "^6.4.17",
        "@types/pg": "^8.11.10",
        "cross-env": "^7.0.3",
        "dotenv-cli": "^7.4.2",
        "eslint": "^9.15.0",
        "tsx": "^4.19.2",
        "typescript": "^5.7.2",
        "typescript-eslint": "^8.15.0",
        "vitest": "^2.1.8",
        "@types/swagger-ui-express": "^4.1.8"
    }
}
