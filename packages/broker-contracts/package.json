        "test:unit:coverage": "pnpm run test:unit -- --coverage"
    },
    "dependencies": {
        "amqplib": "^0.10.4",
        "zod": "^3.24.1"
    },
    "devDependencies": {
        "@types/amqplib": "^0.10.5",
        "@types/node": "^22.19.17",
        "@vitest/coverage-v8": "2.1.9",
        "cross-env": "^7.0.3",
        "typescript": "^5.9.3",
        "vitest": "^2.1.8"
    }
}
