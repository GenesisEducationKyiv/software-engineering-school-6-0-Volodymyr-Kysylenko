NODE_ENV=test

PORT=3001
GRPC_PORT=50053
APP_BASE_URL=http://localhost:3001
LOG_LEVEL=error

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:15432/releases_test
DB_MAX_CONNECTIONS=5
DB_IDLE_TIMEOUT_MS=10000
DB_CONNECTION_TIMEOUT_MS=3000

RATE_LIMIT_WINDOW_MS=300000
RATE_LIMIT_MAX_REQUESTS=500
BODY_LIMIT=10kb

SCAN_INTERVAL_MS=999999999

GITHUB_TOKEN=
GITHUB_API_TIMEOUT_MS=10000

REDIS_URL=redis://localhost:6379
REDIS_TTL_SECONDS=300
CACHE_ENABLED=true

HEALTH_CHECK_INTERVAL_MS=60000
METRICS_ENABLED=true

NOTIFICATION_SERVICE_URL=http://localhost:4000
NOTIFICATION_SERVICE_TIMEOUT_MS=10000
