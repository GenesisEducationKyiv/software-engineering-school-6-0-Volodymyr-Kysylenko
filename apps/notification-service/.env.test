# Notification Service — Test Environment

NODE_ENV=test
PORT=4000
LOG_LEVEL=error

# Public URL of the main app (used to build links in emails)
APP_BASE_URL=http://localhost:3001

# Message broker (RabbitMQ) configuration
RABBITMQ_URL=amqp://notifier:notifier@rabbitmq:5672
RABBITMQ_PREFETCH=5
RABBITMQ_PUBLISH_CONFIRM_TIMEOUT_MS=2000

# Idempotency store (Redis) configuration
REDIS_URL=redis://redis:6379
IDEMPOTENCY_TTL_SECONDS=60

# SMTP configuration
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_EMAIL_FROM=test@example.com
SMTP_USER=
SMTP_PASS=

# Email delivery settings
EMAIL_TIMEOUT_MS=5000
EMAIL_RETRY_ATTEMPTS=1
EMAIL_RETRY_BASE_DELAY_MS=500
EMAIL_RETRY_MAX_DELAY_MS=1000
SHUTDOWN_TIMEOUT_MS=35000
