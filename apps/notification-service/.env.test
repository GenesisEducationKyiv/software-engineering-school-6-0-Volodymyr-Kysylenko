# Notification Service — Test Environment

NODE_ENV=test
PORT=4000
LOG_LEVEL=error

# SMTP configuration
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_EMAIL_FROM=test@example.com
SMTP_USER=
SMTP_PASS=

# Email delivery settings
EMAIL_TIMEOUT_MS=5000
EMAIL_RETRY_ATTEMPTS=1
EMAIL_RETRY_BASE_DELAY_MS=500
EMAIL_RETRY_MAX_DELAY_MS=1000
