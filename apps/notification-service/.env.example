# Notification Service — Example Environment Configuration

# Application environment (development, production, test)
NODE_ENV=production

# HTTP port this service listens on
PORT=4000

# Logging level (error, warn, info, debug)
LOG_LEVEL=info

# Public URL of the main app (used to build links in emails)
APP_BASE_URL=http://localhost:3000

# Message broker (RabbitMQ) configuration
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_PREFETCH=5
RABBITMQ_PUBLISH_CONFIRM_TIMEOUT_MS=5000

# Idempotency store (Redis) configuration
REDIS_URL=redis://localhost:6379
IDEMPOTENCY_TTL_SECONDS=86400

# SMTP configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_EMAIL_FROM=notifications@your-domain.com
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Email delivery settings
EMAIL_TIMEOUT_MS=30000
EMAIL_RETRY_ATTEMPTS=3
EMAIL_RETRY_BASE_DELAY_MS=1000
EMAIL_RETRY_MAX_DELAY_MS=10000
SHUTDOWN_TIMEOUT_MS=35000
